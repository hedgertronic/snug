// The snugshot.app site: static assets only, no Worker script. scripts/deploy_site.sh fills dist/ before deploying.
{
  "name": "snugshot",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "snugshot.app", "custom_domain": true }
  ]
}
